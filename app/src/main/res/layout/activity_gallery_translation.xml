<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_button"
                android:contentDescription="Back"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="sans-serif-bold"
                android:text="@string/gallery_translation"
                android:textColor="@color/text_primary"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- Media Selection & Preview Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SignSpeak.Card.Large"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/ivSelectedMedia"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:background="@drawable/bg_output_box"
                    android:contentDescription="@string/select_image_or_video"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_gallery" />

                <!-- Choose Media Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSelectMedia"
                    style="@style/Widget.SignSpeak.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/choose_from_gallery"
                    app:icon="@drawable/ic_gallery"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconTint="@color/on_primary" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ML Pipeline Visualizer Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SignSpeak.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="@string/processing_pipeline"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <ProgressBar
                    android:id="@+id/pbPipelineProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="8dp"
                    android:indeterminate="true"
                    android:progressTint="@color/primary"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvPipelineStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="sans-serif-monospace"
                    android:text="Ready to process gesture"
                    android:textColor="@color/primary"
                    android:textSize="13sp" />

                <!-- Pipeline Stages Description -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/step_preprocessing"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/step_cnn"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/step_lstm"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/step_classification"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Recognition Output Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardGalleryResult"
            style="@style/Widget.SignSpeak.Card.Large"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvSignResult"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-black"
                        android:text="Select media to translate"
                        android:textColor="@color/primary"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/tvGalleryConfidence"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_tag_online"
                        android:fontFamily="sans-serif-bold"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:text="0.0%"
                        android:textColor="@color/status_online"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvGalleryTranslatedText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_output_box"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/translated_placeholder"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <!-- Action Controls -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCopyResult"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="6dp"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="0dp"
                        android:text="@string/action_copy"
                        android:textSize="12sp"
                        app:cornerRadius="18dp"
                        app:icon="@drawable/ic_content_copy"
                        app:iconPadding="4dp"
                        app:iconSize="14dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPlayResult"
                        style="@style/Widget.SignSpeak.Button.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="6dp"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="0dp"
                        android:text="@string/action_play"
                        android:textSize="12sp"
                        app:cornerRadius="18dp"
                        app:icon="@drawable/ic_volume_up"
                        app:iconPadding="4dp"
                        app:iconSize="14dp"
                        app:iconTint="@color/on_primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnShareResult"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="0dp"
                        android:text="@string/action_share"
                        android:textSize="12sp"
                        app:cornerRadius="18dp"
                        app:icon="@drawable/ic_share"
                        app:iconPadding="4dp"
                        app:iconSize="14dp" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
