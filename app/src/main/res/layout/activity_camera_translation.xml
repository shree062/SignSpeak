<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- CameraX Preview View -->
    <androidx.camera.view.PreviewView
        android:id="@+id/pvCameraPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Dark Semi-transparent Overlay for Framing Target -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#33000000" />

    <!-- Center Target Gesture Box -->
    <View
        android:id="@+id/viewTargetFrame"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:background="@drawable/camera_target_overlay"
        app:layout_constraintBottom_toTopOf="@id/cardLiveResult"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBarCamera" />

    <!-- Frame Alignment Hint -->
    <TextView
        android:id="@+id/tvFrameHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_output_box"
        android:backgroundTint="#80000000"
        android:fontFamily="sans-serif-medium"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:text="@string/align_hand_in_box"
        android:textColor="@color/white"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/viewTargetFrame" />

    <!-- Top Floating Controls Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBarCamera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="36dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_button"
            android:backgroundTint="#80000000"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="sans-serif-bold"
            android:text="@string/camera_translation"
            android:textColor="@color/white"
            android:textSize="18sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Flash Toggle -->
        <ImageButton
            android:id="@+id/btnFlash"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_circle_button"
            android:backgroundTint="#80000000"
            android:contentDescription="@string/toggle_flash"
            android:src="@drawable/ic_flash"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnSwitchCamera"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white" />

        <!-- Switch Camera Toggle -->
        <ImageButton
            android:id="@+id/btnSwitchCamera"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_button"
            android:backgroundTint="#80000000"
            android:contentDescription="@string/switch_camera"
            android:src="@drawable/ic_swap_camera"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Bottom Real-Time Recognition Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardLiveResult"
        style="@style/Widget.SignSpeak.Card.Large"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardBackgroundColor="@color/surface"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Recognized Sign Header & Confidence -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/recognized_sign"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <!-- Confidence Badge -->
                <TextView
                    android:id="@+id/tvConfidence"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tag_online"
                    android:fontFamily="sans-serif-bold"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="94.25%"
                    android:textColor="@color/status_online"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Sign Title -->
            <TextView
                android:id="@+id/tvRecognizedSign"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-black"
                android:text="Waiting for gesture…"
                android:textColor="@color/primary"
                android:textSize="22sp" />

            <!-- Translated Text Sentence Output -->
            <TextView
                android:id="@+id/tvTranslatedSentence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_output_box"
                android:fontFamily="sans-serif-medium"
                android:text="@string/translated_placeholder"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <!-- Action Controls Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Toggle Pause / Resume Recognition -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToggleRecognition"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="0dp"
                    android:text="@string/stop_recognition"
                    android:textSize="12sp"
                    app:cornerRadius="20dp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Play Speech (TTS) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPlaySpeech"
                    style="@style/Widget.SignSpeak.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="0dp"
                    android:text="@string/action_play"
                    android:textSize="12sp"
                    app:cornerRadius="20dp"
                    app:icon="@drawable/ic_volume_up"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp"
                    app:iconSize="14dp"
                    app:iconTint="@color/on_primary" />

                <!-- Copy -->
                <ImageButton
                    android:id="@+id/btnCopyText"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_circle_button"
                    android:contentDescription="@string/action_copy"
                    android:src="@drawable/ic_content_copy"
                    app:tint="@color/text_primary" />

                <!-- Share -->
                <ImageButton
                    android:id="@+id/btnShareText"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circle_button"
                    android:contentDescription="@string/action_share"
                    android:src="@drawable/ic_share"
                    app:tint="@color/text_primary" />

            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
